# =====================================================================
# InnovTech Encaisse — Variables d'environnement (.env.example)
# =====================================================================
# INSTRUCTIONS :
# 1. Copiez ce fichier et renommez la copie en `.env.local`
#    (dans le dossier `encaisse/`).
# 2. Remplissez les valeurs ci-dessous avec vos clés Supabase.
# 3. NE PARTAGEZ JAMAIS votre fichier `.env.local` et ne le mettez
#    jamais sur GitHub (il est ignoré automatiquement par .gitignore).
# =====================================================================

# --- 1. SUPABASE (Obligatoire : Base de données & Authentification) ---
# Où les trouver : Supabase Dashboard > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL="https://votre-projet-id.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# Clé secrète "service_role" (uniquement côté serveur, ne jamais exposer au client)
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# --- 2. INTELLIGENCE ARTIFICIELLE (Optionnel au démarrage) ---
# Si laissé vide, InnovTech Encaisse utilise son analyseur local gratuit
# (expressions régulières FR/EN + modèles de relance intégrés).
# Pour activer Gemini 2.5 Flash-Lite gratuitement (test) :
# Créez une clé sur https://aistudio.google.com/apikey
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash-lite"

# --- 3. PARAMÈTRES DE LA PLATEFORME (Vos coordonnées Super-Admin) ---
# Ces numéros s'affichent aux clients qui veulent payer leur abonnement
# manuellement par Mobile Money ou contacter votre support WhatsApp.
NEXT_PUBLIC_PLATFORM_NAME="InnovTech Encaisse"
NEXT_PUBLIC_SUPPORT_WHATSAPP="237600000000"
NEXT_PUBLIC_ADMIN_MTN_MOMO="670 00 00 00 (Nom : INNOVTECH)"
NEXT_PUBLIC_ADMIN_ORANGE_MONEY="690 00 00 00 (Nom : INNOVTECH)"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

